@model EventFormVm
@{ ViewData["Title"] = "Create Event"; }
<div class="row justify-content-center"><div class="col-lg-8">
    <div class="card rd-card p-4">
        <h1 class="h2 mb-3">Create Event</h1>
        <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
            <partial name="_EventForm" model="Model" />
            <button class="btn btn-rd-accent" type="submit">Create Event</button>
            <a class="btn btn-link" asp-action="Events">Cancel</a>
        </form>
    </div>
</div></div>
